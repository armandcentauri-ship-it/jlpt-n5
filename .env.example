# Copie ce fichier en .env (local) et renseigne les valeurs.

# ── Mode local : SQLite fichier ────────────────────────────────────────────
# (utilisé si TURSO_DATABASE_URL n'est pas défini)
DATABASE_URL=file:./db/custom.db

# ── Mode hébergé : Turso (libSQL distant) ─────────────────────────────────
# Définis ces deux variables pour que l'app parle à la base distante,
# en local comme sur Vercel (elles ont priorité sur DATABASE_URL).
# TURSO_DATABASE_URL=libsql://jlpt-n5-<ton-org>.turso.io
# TURSO_AUTH_TOKEN=eyJ...
